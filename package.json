{
  "name": "fondvnimanie-blockchain",
  "version": "1.0.0",
  "description": "Благотворительный фонд Внимание - веб-сайт с интеграцией блокчейна",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "compile": "truffle compile",
    "migrate": "truffle migrate --network development",
    "migrate:reset": "truffle migrate --reset --network development",
